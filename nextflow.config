// ============================================================
// nextflow.config
// ============================================================

// Default parameters
params {
    sample_sheet = "samples.csv"
    reference    = "data/reference/GCF_000001405.40_GRCh38.p14_rna.fna"
    outdir       = "results"
    gene_panel   = "assets/cancer_gene_panel.json"
    max_cpus     = 16
    max_memory   = "64.GB"
    max_time     = "24.h"
}

// Default process settings
process {
    cpus   = 4
    memory = "8.GB"
    time   = "2.h"

    withLabel: 'low' {
        cpus   = 2
        memory = "4.GB"
    }
    withLabel: 'medium' {
        cpus   = 8
        memory = "16.GB"
    }
    withLabel: 'high' {
        cpus   = 16
        memory = "32.GB"
    }

    withName: 'FETCH_READS' {
        label  = 'low'
    }
    withName: 'TRIM_READS' {
        label  = 'medium'
    }
    withName: 'ALIGN_READS' {
        label  = 'high'
    }
    withName: 'CALL_VARIANTS' {
        label  = 'high'
    }
}

// Execution profiles
profiles {

    local {
        process.executor = 'local'
        docker.enabled   = false
    }

    docker {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {
            withName: 'FETCH_READS'       { container = 'ncbi/sra-tools:3.0.0'          }
            withName: 'TRIM_READS'        { container = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0' }
            withName: 'ALIGN_READS'       { container = 'quay.io/biocontainers/bwa-mem2:2.2.1--he513fc3_0'    }
            withName: 'SORT_INDEX_BAM'    { container = 'quay.io/biocontainers/samtools:1.18--h50ea8bc_1'     }
            withName: 'CALL_VARIANTS'     { container = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'     }
            withName: 'FILTER_SOMATIC'    { container = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'     }
            withName: 'GENE_PANEL_REPORT' { container = 'python:3.11-slim'                                    }
            withName: 'MULTIQC'           { container = 'quay.io/biocontainers/multiqc:1.19--pyhdfd78af_0'    }
        }
    }

    awsbatch {
        process.executor    = 'awsbatch'
        process.queue       = 'nextflow-batch-queue'
        aws.region          = 'us-east-1'
        aws.batch.cliPath   = '/usr/local/bin/aws'

        // S3 working directory — set via NXF_WORK env var or override here
        // workDir = 's3://your-bucket/nextflow-work'

        docker.enabled = true

        process {
            withName: 'FETCH_READS'       { container = 'ncbi/sra-tools:3.0.0'          }
            withName: 'TRIM_READS'        { container = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0' }
            withName: 'ALIGN_READS'       { container = 'quay.io/biocontainers/bwa-mem2:2.2.1--he513fc3_0'    }
            withName: 'SORT_INDEX_BAM'    { container = 'quay.io/biocontainers/samtools:1.18--h50ea8bc_1'     }
            withName: 'CALL_VARIANTS'     { container = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'     }
            withName: 'FILTER_SOMATIC'    { container = 'quay.io/biocontainers/bcftools:1.18--h8b25389_0'     }
            withName: 'GENE_PANEL_REPORT' { container = 'python:3.11-slim'                                    }
            withName: 'MULTIQC'           { container = 'quay.io/biocontainers/multiqc:1.19--pyhdfd78af_0'    }
        }
    }

    // SGE profile (mirrors your original class cluster setup)
    sge {
        process.executor = 'sge'
        process {
            clusterOptions = '-j y -pe smp ${task.cpus}'
            withLabel: 'high' {
                clusterOptions = '-j y -pe smp 16 -l h=colony-02'
            }
        }
    }
}

// Capture pipeline execution info
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
}
