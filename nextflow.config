// ============================================================
// nextflow.config
// ============================================================

// Default parameters
params {
    sample_sheet = "samples.csv"
    reference    = "data/reference/GCF_000001405.40_GRCh38.p14_rna.fna"
    outdir       = "results"
    gene_panel   = "assets/cancer_gene_panel.json"
    max_cpus     = 16
    max_memory   = "64.GB"
    max_time     = "24.h"

    // AWS Batch — override at runtime with --aws_region and --aws_queue
    aws_region   = 'us-east-1'
    aws_queue    = 'nextflow-bio-queue'
}

// Wave builds containers on-demand from conda specs — no hardcoded registry URIs needed
wave {
    enabled  = true
    strategy = 'conda,container'
}

// Seqera Platform monitoring — set TOWER_ACCESS_TOKEN in your environment
tower {
    enabled = true
}

// Default process settings
process {
    cpus   = 4
    memory = "8.GB"
    time   = "2.h"

    withLabel: 'low' {
        cpus   = 2
        memory = "4.GB"
    }
    withLabel: 'medium' {
        cpus   = 8
        memory = "16.GB"
    }
    withLabel: 'high' {
        cpus   = 16
        memory = "32.GB"
    }

    withName: 'FETCH_READS'       { label = 'low';    conda = 'bioconda::sra-tools=3.0.0'                        }
    withName: 'TRIM_READS'        { label = 'medium'; conda = 'bioconda::trim-galore=0.6.10'                     }
    withName: 'ALIGN_READS'       { label = 'high';   conda = 'bioconda::bwa-mem2=2.2.1'                        }
    withName: 'SORT_INDEX_BAM'    {                   conda = 'bioconda::samtools=1.18'                          }
    withName: 'CALL_VARIANTS'     { label = 'high';   conda = 'bioconda::bcftools=1.18'                         }
    withName: 'FILTER_SOMATIC'    {                   conda = 'bioconda::bcftools=1.18'                          }
    withName: 'GENE_PANEL_REPORT' {                   conda = 'conda-forge::python=3.11 bioconda::pyvcf'         }
    withName: 'MULTIQC'           {                   conda = 'bioconda::multiqc=1.19'                           }
}

// Execution profiles
profiles {

    local {
        process.executor = 'local'
        docker.enabled   = false
        wave.enabled     = false
    }

    docker {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        // Wave provisions containers from conda specs defined in the process block above
    }

    awsbatch {
        process.executor    = 'awsbatch'
        process.queue       = params.aws_queue
        aws.region          = params.aws_region
        aws.batch.cliPath   = '/usr/local/bin/aws'

        docker.enabled = true
        // Wave provisions containers from conda specs defined in the process block above
    }

    // SGE profile (mirrors your original class cluster setup)
    sge {
        process.executor = 'sge'
        wave.enabled     = false
        process {
            clusterOptions = '-j y -pe smp ${task.cpus}'
            withLabel: 'high' {
                clusterOptions = '-j y -pe smp 16 -l h=colony-02'
            }
        }
    }
}

// Capture pipeline execution info
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
}
